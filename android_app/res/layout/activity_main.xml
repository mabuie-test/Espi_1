<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pronto para iniciar"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Controle remoto só funciona se ativado pelo próprio usuário." />

    <CheckBox
        android:id="@+id/remoteControlCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Permitir iniciar/parar remotamente (com consentimento)"/>

    <Spinner
        android:id="@+id/sourceSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/consentButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dar Consentimento" />

    <Button
        android:id="@+id/startVideoAudioButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar Vídeo + Áudio" />

    <Button
        android:id="@+id/startAudioButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar Apenas Áudio" />

    <Button
        android:id="@+id/pauseButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pausar" />

    <Button
        android:id="@+id/resumeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Retomar" />

    <Button
        android:id="@+id/stopButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Parar e Enviar" />
</LinearLayout>
</ScrollView>
